# Admin password for accessing admin panel
# Change this to a secure password in production!
ADMIN_PASSWORD="admin123"

# Optional: Static admin token for API access (e.g., for CI/CD)
# ADMIN_TOKEN="your-static-token-here"

# Demo mode for Vercel deployment (no database needed)
# Set to "true" on Vercel to use static demo data instead of SQLite
# Remove or set to "false" for production (VPS with SQLite)
NEXT_PUBLIC_DEMO_MODE="false"
